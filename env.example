PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your connection string from MongoDB Atlas (Database > Connect > Drivers > Node.js):
# Example: mongodb+srv://fituser:securepass123@cluster0.abcde.mongodb.net/fitpulse?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/fitpulse?retryWrites=true&w=majority

# Secret key for JWT authentication
JWT_SECRET=fitness_logger_academic_secret_key_2026

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Gmail / SMTP credentials for email verification
# If left blank, FitPulse will display the 6-digit OTP code directly in the terminal console for convenient local testing
EMAIL_USER=
EMAIL_PASS=
